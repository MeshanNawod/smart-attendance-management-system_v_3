<WixLocalization Culture="en-us" xmlns="http://schemas.microsoft.com/wix/2006/localization"><String Id="TauriLanguage">1033</String><String Id="TauriCodepage">1252</String><String Id="LaunchApp">Launch Sentinel Swarm AMS</String><String Id="DowngradeErrorMessage">A newer version of Sentinel Swarm AMS is already installed.</String><String Id="PathEnvVarFeature">Add the install location of the Sentinel Swarm AMS executable to the PATH system environment variable. This allows the Sentinel Swarm AMS executable to be called from any location.</String><String Id="InstallAppFeature">Installs Sentinel Swarm AMS.</String></WixLocalization>