# ─── Auto-detect text files and normalize to LF ─────────
* text=auto eol=lf

# ─── Explicit text files (always LF) ────────────────────
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.env text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# ─── Binary files (never touch) ─────────────────────────
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.zip binary
*.bin binary
*.hex binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
